    <!-- ntfy / UnifiedPush -->
    <string name="ntfy_title">Push from Paperless (ntfy)</string>
    <string name="ntfy_intro">Paperless can tell your phone when documents arrive by email or through the consume folder, through your own ntfy server, without Google services. PaperCtrl gets a private address from the ntfy app; a Paperless workflow sends to it.</string>
    <string name="ntfy_no_distributor">Install the ntfy app</string>
    <string name="ntfy_no_distributor_body">Install ntfy (from F-Droid) or another UnifiedPush app, point it at your ntfy server, then come back here.</string>
