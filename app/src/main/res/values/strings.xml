    <!-- Errors -->
    <string name="error_unreachable">Couldn\'t reach the server. Check the address, and that your phone can reach it (Wi-Fi, VPN).</string>
    <string name="error_tls">The secure connection failed, so nothing was sent. The server\'s certificate wasn\'t accepted.</string>
    <string name="error_cert_changed">The server\'s certificate has changed since you trusted it. Remove the server and add it again to check the new one.</string>
    <string name="error_bad_credentials">Wrong username or password.</string>
    <string name="error_bad_token">The server didn\'t accept the token. It may have been deleted or replaced; sign in again.</string>
    <string name="error_mfa_required">This account uses two-factor authentication. Enter the code from your authenticator app.</string>
    <string name="error_mfa_invalid">That authentication code wasn\'t right. Codes change every 30 seconds; try the current one.</string>
    <string name="error_not_paperless">Something answered at this address, but not Paperless-ngx\'s API. Check the address; if Paperless runs under a sub-path, include it (for example example.com/paperless).</string>
    <string name="error_proxy_login">The address forwards to a sign-in page on %1$s instead of to Paperless. If your reverse proxy protects Paperless with a login (Authelia, Authentik…), let the /api/ path through without it, or use the home-network address.</string>
    <string name="error_too_old">This Paperless-ngx version is too old for PaperCtrl. Update the server to a current version.</string>
    <string name="error_too_old_version">This server runs Paperless-ngx %1$s, which is too old for PaperCtrl. Update it to a current version.</string>
    <string name="error_forbidden">Your account isn\'t allowed to do this on the server.</string>
    <string name="error_not_found">It\'s no longer on the server.</string>
    <string name="error_throttled">Too many attempts. Wait a minute and try again.</string>
    <string name="error_server">The server ran into a problem. Check its logs.</string>
    <string name="error_unexpected">Something unexpected went wrong.</string>
    <string name="error_cleartext_blocked">Blocked an unencrypted (HTTP) connection the server redirected to.</string>
