<?xml version="1.0" encoding="utf-8"?>
<!-- The server address is typed by the user, so cleartext can't be limited to a fixed domain here.
     Plain HTTP stays possible at the platform level for home-network servers, but the app enforces
     it in code: HTTP is only used for a server the user explicitly chose after an "unencrypted"
     warning. Self-signed certificates are trusted per server in code, by a SHA-256 fingerprint the
     user confirmed; there is no global "trust all". User-installed CAs are trusted so servers behind
     a private CA work. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
